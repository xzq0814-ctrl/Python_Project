# 忽略 Python 编译产生的缓存文件
__pycache__/
*.py[cod]

# 忽略虚拟环境文件夹（如果你有的话，通常叫 venv 或 env）
venv/
env/

# 忽略编辑器产生的本地配置（如 VS Code, PyCharm）
.vscode/
.idea/

# 忽略包含密码或 API Key 的本地配置文件
.env
config_local.py
